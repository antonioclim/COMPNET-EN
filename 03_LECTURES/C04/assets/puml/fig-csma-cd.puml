@startuml fig-csma-cd
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
title CSMA/CD — half-duplex Ethernet only
start
:Attempts = 0;
repeat
  while (Medium busy?) is (yes)
    :Defer and sense again;
  endwhile (idle)
  :Begin transmitting frame;
  if (Collision detected?) then (yes)
    :Send jam signal and stop transmission; <<#FFCDD2>>
    :Attempts = attempts + 1;
    if (Attempts >= 16?) then (yes)
      :Abort and report failure; <<#FFCDD2>>
      stop
    endif
    :Choose k = min(attempts, 10)\nWait random 0..(2^k - 1) slot times; <<#FFE0B2>>
  else (no)
    :Complete transmission; <<#C8E6C9>>
    stop
  endif
repeat while (Retry frame?) is (yes)
@enduml
