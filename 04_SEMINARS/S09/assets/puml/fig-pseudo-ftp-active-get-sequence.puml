@startuml fig-pseudo-ftp-active-get-sequence
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam sequenceMessageAlign center

title Pseudo-FTP — active_get sequence

participant "Client\n(S09_Part02C client)" as C #FFE0B2
participant "Client data\nlistener" as CL #FFF9C4
participant "Server\n(S09_Part02B server)" as S #C8E6C9

C -> C : bind() + listen()\non ephemeral port P

C -> S : active_get filename P + LF\n(control connection :3333)

S -> S : open FILE_ROOT/filename

S --> C : framed "READY"\n(control connection)
S -> CL : connect(client_ip, P)\n(data connection)
S -> CL : sendall(1-byte length + content)
CL --> S : TCP ACK
S --> C : framed "done!"\n(control connection; client consumes it)

C -> C : save to ./client-temp/filename

legend bottom
  Active mode: the client opens a temporary listener.
  The server connects back to the client on the announced port.
  This mirrors real FTP PORT/active transfer behaviour.
endlegend
@enduml
