@startuml fig-s02-command-protocol
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false

title Command Protocol — Server-Side Decision Logic

start

:Receive message from client;

:Decode bytes to UTF-8 string;

:Strip whitespace;

if (message == "ping") then (yes)
  :response = "PONG"; <<#C8E6C9>>
elseif (message starts with "upper:") then (yes)
  :Extract text after "upper:"
  response = text.upper(); <<#BBDEFB>>
else (default)
  :response = "UNKNOWN COMMAND"; <<#FFCDD2>>
endif

:Encode response to bytes;

:Send response to client;

:Log client IP, port,
message text and byte count;

stop

legend right
  Optional ping/upper command parser.
  It can be implemented for either transport.
  TCP: response via sendall()
  UDP: response via sendto()
  Optional extension after the base tasks.
  Part02 TCP base: OK: + uppercase + LF.
  TCP requests and replies use LF framing.
endlegend
@enduml
