@startuml fig-dnssec-chain-of-trust
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
title DNSSEC: parent delegation and child DNSKEY RRset
package "Root zone" #FCE4EC {
  rectangle "Root DNSKEY RRset\nKSK trust anchor + ZSK\nRRSIG(DNSKEY)" as root
  rectangle "DS for .com + RRSIG(DS)" as comds
}
package ".com zone" #FFF3E0 {
  rectangle ".com DNSKEY RRset\nKSK + ZSK + RRSIG(DNSKEY)" as comkey
  rectangle "DS for example.com + RRSIG(DS)" as exds
}
package "example.com zone" #E8F5E9 {
  rectangle "example.com DNSKEY RRset\nKSK + ZSK + RRSIG(DNSKEY)" as exkey
  rectangle "A / MX / other RRsets\nwith RRSIG records" as data
}
root --> comds : validate parent signature
comds --> comkey : digest matches child DNSKEY;\nvalidate child DNSKEY RRset
comkey --> exds : validate parent signature
exds --> exkey : digest matches child DNSKEY;\nvalidate child DNSKEY RRset
exkey --> data : validate RRset signatures
legend bottom
  The KSK signs the DNSKEY RRset, not just the ZSK in isolation.
  A validated absence of DS can establish an insecure delegation.
  A failed required signature/chain validation is bogus, not insecure.
endlegend
@enduml
