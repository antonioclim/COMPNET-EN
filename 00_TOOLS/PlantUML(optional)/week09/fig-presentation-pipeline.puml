@startuml fig-presentation-pipeline
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
title Text and binary serialisation paths
rectangle "Application object" as object
rectangle "Text serialisation\nJSON / XML" as text
rectangle "Character encoding\nUTF-8" as encoding
rectangle "Binary serialisation\nProtobuf / MessagePack" as binary
rectangle "Bytes\nOptional compression" as bytes
rectangle "Protocol payload" as wire
object --> text
text --> encoding
encoding --> bytes
object --> binary
binary --> bytes : already bytes
bytes --> wire
legend bottom
  Both peers agree on the serialisation and any content coding.
  Binary serialisation does not require a character-encoding stage.
endlegend
@enduml
