@startuml fig-csma-ca
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam shadowing false
title CSMA/CA — simplified DCF unicast with ACK
start
:Retries = 0\nContention window = CWmin;
repeat
  :Wait for idle medium for DIFS;
  :Choose random backoff in contention window;
  while (Backoff > 0?) is (yes)
    if (Medium idle for one slot?) then (yes)
      :Decrement backoff;
    else (busy)
      :Freeze counter\nWait for idle medium for DIFS;
    endif
  endwhile (zero)
  :Transmit frame;
  if (ACK received before timeout?) then (yes)
    :Success and reset contention window; <<#C8E6C9>>
    stop
  else (no)
    :No ACK: loss or collision is possible; <<#FFCDD2>>
    :Increment retry count;
    if (Retry limit reached?) then (yes)
      :Report failure; <<#FFCDD2>>
      stop
    endif
    :Increase contention window up to CWmax;
  endif
repeat while (Retry frame?) is (yes)
@enduml
