@startuml fig-S12-e2-message-flow
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam sequenceMessageAlign center

title S12 — E2 Path: TLS Handshake and Authenticated Messaging

participant "tester\n(TLS client)" as C #FFE0B2
participant "tls_server\n:5443" as S #C8E6C9

== TCP HANDSHAKE ==
C -> S : SYN
S --> C : SYN-ACK
C -> S : ACK

== TLS HANDSHAKE ==
C -> S : ClientHello\n(supported ciphers, SNI)
S --> C : ServerHello\n(selected cipher)
alt TLS 1.2 (ECDHE example)
S --> C : Certificate + ServerKeyExchange + ServerHelloDone
C -> C : Verify CA chain, hostname and expiry
C -> S : ClientKeyExchange + ChangeCipherSpec + Finished
S --> C : ChangeCipherSpec + Finished
else TLS 1.3
note over C, S : Key shares in ClientHello / ServerHello
S --> C : EncryptedExtensions + Certificate\n+ CertificateVerify + Finished (encrypted)
C -> C : Verify CA chain, hostname, expiry and transcript
C -> S : Finished (encrypted)
end

== ENCRYPTED CHANNEL ESTABLISHED ==
note over C, S #E1BEE7 : All subsequent data encrypted\n(opaque in PCAP without SSLKEYLOGFILE)

== APPLICATION PROTOCOL (encrypted) ==
C -[#1565C0]-> S : AUTH alice password123
S -[#43A047]-> C : OK AUTH

C -[#1565C0]-> S : SEND bob "Hello secure"
S -[#43A047]-> C : OK SEND

C -[#1565C0]-> S : QUIT
S --> C : OK QUIT

== TLS CLOSURE ==
C -> S : close_notify
S --> C : close_notify
C -> S : FIN

legend right
  PCAP visible: ClientHello, ServerHello
  TLS 1.2 Certificate is normally visible; TLS 1.3 Certificate is encrypted
  PCAP opaque: application commands (encrypted)
  R1–R5 are capture smoke checks
  Certificate and application acceptance require client tests
endlegend
@enduml
