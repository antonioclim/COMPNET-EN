{
  "project": "A04",
  "pcap_relpath": "artifacts/pcap/traffic_e2.pcap",
  "decode_as": [],
  "rules": [
    {
      "id": "R1",
      "filter": "arp.opcode==1",
      "condition": ">= 1",
      "description": "ARP request present (context)."
    },
    {
      "id": "R2",
      "filter": "arp.opcode==2",
      "condition": ">= 5",
      "description": "At least 5 ARP replies (potential spoofing)."
    },
    {
      "id": "R3",
      "filter": "arp",
      "condition": ">= 10",
      "description": "Sufficient ARP traffic for analysis."
    }
  ],
  "manual_checks": [
    "R1 R2 R3: Compare IP/MAC mappings and detector alerts, then verify the repaired victim cache and restored ping separately."
  ]
}
