{
  "project": "S03",
  "pcap_relpath": "artifacts/pcap/traffic_e2.pcap",
  "decode_as": [
    "tcp.port==8080,http"
  ],
  "rules": [
    {
      "id": "R1",
      "filter": "tcp.dstport==8080 && tcp.flags.syn==1 && tcp.flags.ack==0",
      "condition": ">= 1",
      "description": "SYN connection attempt to the HTTP server."
    },
    {
      "id": "R2",
      "filter": "tcp.dstport==8080 && http.request.method==\"GET\" && !tcp.analysis.retransmission",
      "condition": ">= 2",
      "description": "At least two decoded GET requests in one TCP stream; count HTTP messages, not frames.",
      "measurement": "field_occurrences",
      "field": "http.request.method",
      "value": "GET",
      "aggregation": "max_per_stream"
    },
    {
      "id": "R3",
      "filter": "tcp.srcport==8080 && http.response.code==200",
      "condition": ">= 1",
      "description": "Decoded HTTP 200 response."
    },
    {
      "id": "R4",
      "filter": "tcp.srcport==8080 && http.response.code==404",
      "condition": ">= 1",
      "description": "Decoded HTTP 404 response."
    },
    {
      "id": "R5",
      "filter": "tcp.srcport==8080 && http.content_type",
      "condition": ">= 1",
      "description": "Decoded Content-Type response header."
    }
  ],
  "manual_checks": [
    "R1 R2 R3 R4 R5: Assert both decoded responses, Content-Type, Content-Length/body framing and reuse of the same TCP stream. Test HEAD separately as required by the brief."
  ]
}
